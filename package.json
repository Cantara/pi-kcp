{
  "name": "@cantara/pi-kcp",
  "version": "0.3.0",
  "description": "Open-source KCP ergonomics for the Pi coding-agent harness",
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "pr-eval": "bun scripts/pr-eval.ts",
    "smoke": "./scripts/smoke-extension.sh",
    "validate-install": "bun scripts/validate-install.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests"
  },
  "pi": {
